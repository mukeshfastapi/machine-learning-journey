





import numpy as np
import matplotlib.pyplot as plt
import pandas as pd





dataset = pd.read_csv('Salary_Data.csv')
X = dataset.iloc[:, :-1].values
y = dataset.iloc[:, -1].values





from sklearn.model_selection import train_test_split
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size = 0.2, random_state=0)





from sklearn.linear_model import LinearRegression
regressior = LinearRegression()
regressior.fit(X_train, y_train)





y_pred = regressior.predict(X_test)





plt.scatter(X_train, y_train, color = 'green')
plt.plot(X_train, regressior.predict(X_train), color = 'red')
plt.title('Salary vs Experience (Training set)')
plt.xlabel('Years of Experience')
plt.ylabel('Salary')
plt.show()





plt.scatter(X_test, y_test, color = 'red')
plt.plot(X_train, regressior.predict(X_train), color = 'green')
plt.title('Salary vs Experience (Test set)')
plt.xlabel('Years of Experience')
plt.ylabel('Salary')
plt.show()





print(regressior.predict([[12]]))


print(regressior.coef_)
print(regressior.intercept_)



